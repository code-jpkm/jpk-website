# Copy to .env.local for running on your computer. On Render, enter these under Environment.

# Required: MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/jpk?retryWrites=true&w=majority

# Required in production: a long random secret for sign-in sessions (Render's Blueprint creates one)
JWT_SECRET=change-me-to-a-long-random-text

# First administrator, created automatically when the database has no users yet
SEED_ADMIN_EMAIL=sales@jpkm.in
SEED_ADMIN_PASSWORD=admin@123

# Pictures on Cloudinary (recommended). From the Cloudinary console, https://console.cloudinary.com :
#   CLOUDINARY_CLOUD_NAME   Dashboard, at the top: "Cloud name"
#   CLOUDINARY_API_KEY      Settings → API Keys: "API Key"
#   CLOUDINARY_API_SECRET   Settings → API Keys: "API Secret" (click the eye icon to see it)
# Leave all three empty to keep pictures in MongoDB instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or, instead of the three lines above, all three in one line (Cloudinary's "API environment variable"):
# CLOUDINARY_URL=cloudinary://<API key>:<API secret>@<cloud name>

# The public website: "View on website" links, and the website editor shows this site in its preview and reads
# its list of editable items from it (WEBSITE_URL/site-schema.json). Until jpkm.in shows the new website, put the
# new website's address here (for example its Vercel address). On your computer: http://localhost:5173, with the
# website started with VITE_API_URL=http://localhost:3000.
WEBSITE_URL=https://jpkm.in

# Optional: rebuild the website after posts, jobs or website-editor changes (deploy hook of the website host)
SITE_REBUILD_HOOK_URL=

# Optional: only these websites may send forms (comma-separated). Default: any
# ALLOWED_ORIGINS=https://jpkm.in,https://www.jpkm.in

# Optional email alerts for new enquiries and applications.
# Render's free plan blocks SMTP, so use Resend there (https://resend.com, free plan available):
RESEND_API_KEY=
MAIL_FROM=JPK Website <alerts@jpkm.in>
NOTIFY_EMAIL=sales@jpkm.in
CAREERS_NOTIFY_EMAIL=
# …or SMTP (works on paid Render instances and on your own server):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
